{
  "name": "@fstack/dsh-panel-entry",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace panel for saved agent replies, todos, and NOTES.md in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/store.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffy6511/fstack.git",
    "directory": "dsh-plugins/panel-entry-plugin"
  },
  "homepage": "https://github.com/ffy6511/fstack/tree/main/dsh-plugins/panel-entry-plugin",
  "bugs": {
    "url": "https://github.com/ffy6511/fstack/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
