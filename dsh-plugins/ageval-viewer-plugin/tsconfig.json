{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "jsx": "react",
    "moduleResolution": "Node",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowJs": false,
    "noEmitOnError": false,
    "outDir": ".build"
  },
  "include": ["src/client.tsx"]
}
